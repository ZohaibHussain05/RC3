# Copy to .env and fill in. NEVER commit or submit .env, and never paste these values into a chat.
GITHUB_TOKEN=
WEBHOOK_SECRET=
# Comma-separated allowlist of repos the reviewer may act on (strongly recommended)
ALLOWED_REPOS=yourname/pr-reviewer-test

TICKET_PROVIDER=jira
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional: a custom field that holds acceptance criteria (otherwise the "Acceptance Criteria" section of the description is used)
JIRA_AC_FIELD=

# For Azure DevOps instead of Jira:
# TICKET_PROVIDER=azure
# AZURE_ORG_URL=https://dev.azure.com/yourorg
# AZURE_PROJECT=
# AZURE_PAT=
# TICKET_PATTERN=AB#(\d+)

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Safety switches: dry run is ON and auto-merge is OFF by default
DRY_RUN=true
AUTO_MERGE_ENABLED=false
MERGE_METHOD=squash
MAX_DIFF_CHARS=60000
PORT=8080
